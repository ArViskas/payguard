# No installation or credentials required for the offline demo.
PAYMENT_PROVIDER=demo
AI_PROVIDER=demo
PORT=3000
# Optional private operator passphrase. Demo default: payguard-demo
OPERATOR_PIN=

# Sandbox only. Set PAYMENT_PROVIDER=paypal-sandbox to enable.
# Obtain these from YOUR sandbox REST app. Never use live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required in sandbox mode: an actual personal SANDBOX account email.
SANDBOX_RECIPIENT_EMAIL=
# Sandbox mode also requires OPERATOR_PIN with at least 12 characters.

# Optional real, local model. No paid AI API is needed.
# Set AI_PROVIDER=ollama and run your own installed Ollama model.
OLLAMA_MODEL=qwen2.5:1.5b
